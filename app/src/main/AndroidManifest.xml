<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Granted by hand in Settings > Apps > Special access > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Place signal, NOT declared in this release. Deliberately commented out rather
         than deleted, because the four terms behind them are intact and measured and the
         only thing standing between them and working again is these three lines plus
         Permissions.LOCATION_DECLARED — which carries the reasoning, and is the thing to
         read before uncommenting these.

         The short version: the family measured at about one point of Hit@4 across all
         four terms over 13.8 days, which is inside the error bar, and ACCESS_BACKGROUND_
         LOCATION is the most heavily reviewed permission on Play. The refresh runs with
         nothing of ours on screen, so while-in-use is refused and there is no lesser
         version of the ask to fall back to.

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    -->

    <!-- Kept while the place signal is off, because WorkManager checks network
         constraints and merges this in regardless. It is a normal permission: no prompt,
         no Play scrutiny, nothing shown to the user. When location comes back it is also
         what the WiFi-identity network callback needs. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The ad bar and the purchase check, and nothing else. For most of this project
         there was no network permission at all, and the privacy claim was the strong form
         — the usage history *could not* leave the device, whatever a bug did. That is no
         longer true and the README says so in those words rather than quietly softening.

         What is still true is narrower and worth stating exactly: no code of ours reads
         the session, breadcrumb, notification or impression tables and writes them to a
         socket. The ranking is computed on the device from data that stays on the device.
         What crosses the network is the ad request, the advertising ID that the Google
         Mobile Ads SDK attaches to it, and the Play Billing round-trip that answers "has
         this person paid". See README, "Privacy" and "Ads".

         com.google.android.gms.permission.AD_ID is not declared here because the ads SDK
         merges it in from its own manifest. It still has to be declared on the Data
         Safety form, which is the part that is easy to forget. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Meeting signal. Read-only, and nothing from an event is ever stored: titles
         and descriptions are scanned for a meeting link in memory and discarded. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />


    <!-- WorkManager's period does survive a reboot, but only comes due when it comes
         due, and the first thing you see after a restart is the home screen. This is
         what lets us re-rank immediately instead. Notably absent: any alarm permission
         at all — the refresh is a WorkManager period now. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Suggest">

        <!-- Substituted from admob.properties by the build, falling back to Google's
             published test app ID. The SDK reads this at initialisation and throws if it
             is missing or malformed, so it is not optional even in a build nobody
             intends to monetise. See app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Both recommended by Google and both about the same failure: the ads SDK does
             disk and network work during initialisation and during the first ad load, and
             on the main thread that surfaces as an ANR rather than as a slow ad. These
             move it off. Ads.start also calls initialize from a background thread, which
             is belt and braces — the flags cover the parts of the SDK we do not call. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <!-- No android:label: the application tag already carries the same one, and a
             duplicate is one more place to forget when it changes. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible hop so a tap can be recorded as feedback before the target
             app takes over. Cheaper than a Glance ActionCallback round-trip. -->
        <activity
            android:name=".widget.LaunchTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Trampoline" />

        <!-- One receiver per size. Glance resolves a widget's placed instances by the
             exact class of its GlanceAppWidget, so a shared receiver could never push an
             update to more than one size. SuggestWidgetReceiver is the 4x2 and keeps its
             original name: it is the provider the widget already on the home screen is
             bound to, and renaming it would delete that widget on update. -->
        <receiver
            android:name=".widget.SuggestWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_4x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/suggest_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SuggestWidgetReceiver2x2"
            android:exported="true"
            android:label="@string/widget_label_2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/suggest_widget_info_2x2" />
        </receiver>

        <receiver
            android:name=".widget.SuggestWidgetReceiver2x3"
            android:exported="true"
            android:label="@string/widget_label_2x3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/suggest_widget_info_2x3" />
        </receiver>

        <receiver
            android:name=".widget.SuggestWidgetReceiver4x3"
            android:exported="true"
            android:label="@string/widget_label_4x3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/suggest_widget_info_4x3" />
        </receiver>

        <receiver
            android:name=".widget.SuggestWidgetReceiver4x5"
            android:exported="true"
            android:label="@string/widget_label_4x5">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/suggest_widget_info_4x5" />
        </receiver>

        <!-- Records only which app posted and when; see NotifListener. Off by
             default, and the service asks to be unbound while its toggle is off. -->
        <service
            android:name=".sense.NotifListener"
            android:exported="false"
            android:label="@string/notif_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".work.PackageChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Re-rank when a signal actually changes rather than when the clock says to.
             Enabled and disabled as a component by Scheduler.ensureEventReceiver, so
             switching the setting off stops delivery instead of waking us to ignore
             it. SCREEN_ON is absent on purpose — the platform will not deliver it to a
             manifest receiver at all — and headphones are watched as audio devices
             rather than as a broadcast. Both are registered at runtime instead. See
             ScreenTriggers. -->
        <receiver
            android:name=".work.EventTriggerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- Never disabled, unlike the receiver above: the event triggers are optional
             and coming back up with a current grid is not. See BootReceiver. -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
