<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Same dark bar icons as the day theme, which looks wrong written down and is not.
      MainActivity calls MaterialTheme with no colorScheme, so Compose uses the light one
      in both modes, and Surface(fillMaxSize) paints over the dark window background this
      style sets before any of it reaches the screen. The content under the bars is
      therefore light at night too, so the icons over it have to be dark at night too.

      The honest fix for the mismatch is a dark colour scheme in the Compose layer, at
      which point these two values diverge and this comment goes away.
    -->
    <style name="Theme.Suggest" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
